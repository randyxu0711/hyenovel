{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyenovel/label-map.schema.json",
  "title": "hyenovel cross-story label map",
  "description": "跨篇概念地圖(stories/label-map.json)。衍生快取,可整份刪掉重建。concepts 扁平且可多屬:同一個 (slug,node) 可以出現在多個 concept 的 members 裡 —— 泡沫同時掛在「水」與「消逝」,多屬正是為了保住概念的立體。id / quote / built_at / analysis_fps / titles 由確定性層蓋章,LLM 不得自填。",
  "type": "object",
  "additionalProperties": false,
  "required": ["built_at", "analysis_fps", "titles", "source_node_count", "concepts"],
  "properties": {
    "built_at": {"type": "number"},
    "analysis_fps": {"type": "object", "additionalProperties": {"type": "string"}},
    "titles": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_node_count": {"type": "integer", "minimum": 0},
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonical", "node_type", "members"],
        "properties": {
          "id": {"type": "string", "pattern": "^L[0-9]{3,}$"},
          "canonical": {"type": "string", "minLength": 1},
          "node_type": {"enum": ["motif", "theme", "technique", "effect"]},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "node", "label", "why", "evidence_index", "quote"],
              "properties": {
                "slug": {"type": "string", "minLength": 1},
                "node": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "why": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "evidence_index": {"type": "integer", "minimum": 0},
                "quote": {"type": "string", "minLength": 1, "pattern": "\\S"}
              }
            }
          }
        }
      }
    }
  }
}
